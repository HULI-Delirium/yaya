<Window x:Class="Yaya.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Yaya.App.ViewModels"
        xmlns:monitoring="clr-namespace:Yaya.Core.Monitoring;assembly=Yaya.Core"
        Title="芽芽 · 设置" Width="400" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Loaded="OnLoaded">
    <Window.Resources>
        <!-- 规则行：两行式（启用/目标/值/排序 + 类别/仅浏览器），400px 宽可放下 -->
        <DataTemplate x:Key="RuleRowTemplate" DataType="{x:Type vm:RuleRowViewModel}">
            <Border BorderBrush="#FFE6E6E6" BorderThickness="0,0,0,1" Padding="0,4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                  ToolTip="启用/停用这条规则" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding TargetMatchLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Value, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="↑" Width="20" Height="20" Padding="0" FontSize="10"
                                    Command="{Binding MoveUpCommand}" ToolTip="上移" />
                            <Button Content="↓" Width="20" Height="20" Padding="0" FontSize="10"
                                    Command="{Binding MoveDownCommand}" ToolTip="下移" />
                            <Button Content="×" Width="20" Height="20" Padding="0" FontSize="10"
                                    Command="{Binding RemoveCommand}" ToolTip="删除" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="22,2,0,0">
                        <TextBlock Text="类别" FontSize="11" VerticalAlignment="Center" />
                        <ComboBox Width="72" Height="22" FontSize="11" Margin="4,0,0,0"
                                  ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Category, Mode=TwoWay}" />
                        <CheckBox Content="仅浏览器" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding BrowserOnly}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTitle}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="芽芽 · 设置" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" FontSize="13" />

            <CheckBox Content="采集（后台轮询前台状态）" IsChecked="{Binding IsMonitoringEnabled}"
                      Margin="0,12,0,0" />
            <CheckBox Content="提醒（游离时气泡询问）" IsChecked="{Binding IsNudgeEnabled}"
                      Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="每日提醒上限：" VerticalAlignment="Center" />
                <TextBox Text="{Binding NudgeDailyLimitText, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                <TextBlock Text=" 次（1–10）" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox Content="免打扰时段（时段内不弹气泡）" IsChecked="{Binding IsQuietHoursEnabled}"
                      Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="从 " VerticalAlignment="Center" />
                <TextBox Text="{Binding QuietStartText, UpdateSourceTrigger=PropertyChanged}" Width="52" />
                <TextBlock Text=" 到 " VerticalAlignment="Center" />
                <TextBox Text="{Binding QuietEndText, UpdateSourceTrigger=PropertyChanged}" Width="52" />
                <TextBlock Text="（HH:mm）" VerticalAlignment="Center" Foreground="Gray" />
            </StackPanel>
            <CheckBox Content="显示宠物（关闭后仍可从托盘恢复）" IsChecked="{Binding IsPetVisible}"
                      Margin="0,8,0,0" />
            <CheckBox Content="宠物窗鼠标穿透（不可拖动，菜单也不可用）" IsChecked="{Binding IsClickThrough}"
                      Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="专注分钟：" VerticalAlignment="Center" />
                <TextBox Text="{Binding FocusMinutesText, UpdateSourceTrigger=PropertyChanged}" Width="46" />
                <TextBlock Text="  休息分钟：" VerticalAlignment="Center" />
                <TextBox Text="{Binding BreakMinutesText, UpdateSourceTrigger=PropertyChanged}" Width="46" />
            </StackPanel>

            <GroupBox Header="应用与网页" Margin="0,14,0,0" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="{Binding AppRules.CurrentAppText}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AppRules.CurrentCategoryText}" FontSize="11" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding AppRules.CurrentReasonText}" FontSize="11" Foreground="Gray"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="学习" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                Command="{Binding AppRules.SetCurrentCategoryCommand}"
                                CommandParameter="{x:Static monitoring:RuleCategory.Study}" />
                        <Button Content="工具" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                Command="{Binding AppRules.SetCurrentCategoryCommand}"
                                CommandParameter="{x:Static monitoring:RuleCategory.Utility}" />
                        <Button Content="娱乐" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                Command="{Binding AppRules.SetCurrentCategoryCommand}"
                                CommandParameter="{x:Static monitoring:RuleCategory.Entertainment}" />
                        <Button Content="社交" FontSize="11" Padding="6,2" Margin="0,0,4,0"
                                Command="{Binding AppRules.SetCurrentCategoryCommand}"
                                CommandParameter="{x:Static monitoring:RuleCategory.Social}" />
                        <Button Content="不打扰" FontSize="11" Padding="6,2"
                                Command="{Binding AppRules.SetCurrentCategoryCommand}"
                                CommandParameter="{x:Static monitoring:RuleCategory.Ignore}" />
                    </WrapPanel>
                    <Button Content="选择窗口…（后台/非前台窗口）" FontSize="11" Padding="6,2"
                            Margin="0,6,0,0" HorizontalAlignment="Left"
                            Command="{Binding OpenWindowPickerCommand}" />

                    <TextBlock Text="规则（先命中先返回；进程规则整体先于标题规则）" FontSize="11"
                               FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="Wrap" />
                    <TextBlock Text="进程规则" FontSize="11" Foreground="Gray" />
                    <ItemsControl ItemsSource="{Binding AppRules.ProcessRules}"
                                  ItemTemplate="{StaticResource RuleRowTemplate}" />
                    <TextBlock Text="标题规则（默认仅浏览器）" FontSize="11" Foreground="Gray" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding AppRules.TitleRules}"
                                  ItemTemplate="{StaticResource RuleRowTemplate}" />

                    <TextBlock Text="添加规则：" FontSize="11" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ComboBox Width="62" Height="22" FontSize="11"
                                  ItemsSource="{Binding AppRules.TargetOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding AppRules.NewTarget, Mode=TwoWay}" />
                        <ComboBox Width="56" Height="22" FontSize="11" Margin="4,0,0,0"
                                  ItemsSource="{Binding AppRules.MatchOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding AppRules.NewMatch, Mode=TwoWay}" />
                        <TextBox Width="120" Height="22" FontSize="11" Margin="4,0,0,0"
                                 Text="{Binding AppRules.NewValue, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="进程名或标题关键词（1–128 字符）" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="类别" FontSize="11" VerticalAlignment="Center" />
                        <ComboBox Width="72" Height="22" FontSize="11" Margin="4,0,0,0"
                                  ItemsSource="{Binding AppRules.CategoryOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding AppRules.NewCategory, Mode=TwoWay}" />
                        <CheckBox Content="仅浏览器" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding AppRules.NewBrowserOnly}"
                                  IsEnabled="{Binding AppRules.IsNewTitle}" />
                        <Button Content="添加" FontSize="11" Padding="10,2" Margin="8,0,0,0"
                                Command="{Binding AppRules.AddRuleCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AppRules.StatusMessage}" FontSize="11" Foreground="#FF2F6B3F"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding AppRules.SummaryText}" FontSize="11" Foreground="Gray"
                                   VerticalAlignment="Center" />
                        <Button Content="恢复默认" FontSize="11" Padding="6,2" Margin="8,0,0,0"
                                Command="{Binding AppRules.ResetRulesCommand}" />
                    </StackPanel>
                    <TextBlock Text="只在本机生效；只保存你输入的字符串；不读取 URL / 网页内容。" FontSize="11"
                               Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="数据与隐私" Margin="0,14,0,0" Padding="10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="数据用途说明" Padding="8,2"
                                Command="{Binding ShowDataUsageCommand}" />
                        <Button Content="打开数据文件夹" Padding="8,2" Margin="8,0,0,0"
                                Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="导出 JSON" Padding="8,2" Margin="8,0,0,0"
                                Command="{Binding ExportJsonCommand}" />
                        <Button Content="导出 CSV" Padding="8,2" Margin="8,0,0,0"
                                Command="{Binding ExportCsvCommand}" />
                    </StackPanel>
                    <Button Content="一键清空本地数据（保留设置）" Padding="8,2" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Command="{Binding ClearDataCommand}" />
                    <TextBlock Text="{Binding DataDirText}" FontSize="11" Foreground="Gray"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="LLM 话术（默认关闭，关闭时永远离线）" Margin="0,10,0,0" Padding="10,8">
                <StackPanel>
                    <CheckBox Content="启用 LLM 润色（仅发送聚合数字，不含任何行为明细）"
                              IsChecked="{Binding IsLlmEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Base URL：https://" VerticalAlignment="Center" />
                        <TextBox Text="{Binding LlmBaseUrlText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="150" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Model：" VerticalAlignment="Center" />
                        <TextBox Text="{Binding LlmModelText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="110" />
                        <TextBlock Text="  API Key：" VerticalAlignment="Center" />
                        <PasswordBox x:Name="LlmApiKeyBox" Width="120"
                                     PasswordChanged="OnLlmApiKeyChanged" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <CheckBox Content="诊断日志（会记录窗口标题，仅排障用；默认关闭）"
                      IsChecked="{Binding IsDiagnosticLoggingEnabled}" Margin="0,10,0,0" />
            <TextBlock Text="数据仅保存在本机 %LOCALAPPDATA%\Yaya；一键清空会删除数据与日志，
                             设置（番茄时长/开关/LLM 配置）与分类规则保留。"
                       FontSize="11" Foreground="Gray" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
