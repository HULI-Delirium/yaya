<Window x:Class="Yaya.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="芽芽 · 设置" Width="360" Height="330"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <StackPanel Margin="16">
        <TextBlock Text="芽芽 · 设置" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" FontSize="13" />
        <CheckBox Content="采集（后台轮询前台状态）" IsChecked="{Binding IsMonitoringEnabled}"
                  Margin="0,14,0,0" />
        <CheckBox Content="提醒（游离时气泡询问）" IsChecked="{Binding IsNudgeEnabled}"
                  Margin="0,8,0,0" />
        <CheckBox Content="宠物窗鼠标穿透（不可拖动）" IsChecked="{Binding IsClickThrough}"
                  Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="专注分钟：" VerticalAlignment="Center" />
            <TextBox Text="{Binding FocusMinutesText, UpdateSourceTrigger=PropertyChanged}" Width="46" />
            <TextBlock Text="  休息分钟：" VerticalAlignment="Center" />
            <TextBox Text="{Binding BreakMinutesText, UpdateSourceTrigger=PropertyChanged}" Width="46" />
        </StackPanel>
        <Button Content="一键清空本地数据" Padding="10,4" Margin="0,16,0,0"
                HorizontalAlignment="Left" Command="{Binding ClearDataCommand}" />
        <TextBlock Text="数据仅保存在本机 %LOCALAPPDATA%\Yaya，清空后不可恢复。"
                   FontSize="11" Foreground="Gray" Margin="0,6,0,0" />
    </StackPanel>
</Window>
