<Window x:Class="Yaya.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="芽芽" Width="380" Height="230"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <StackPanel Margin="16">
        <TextBlock Text="芽芽 · 学习节律陪伴" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" FontSize="14" />
        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="Gray" TextWrapping="Wrap"
                   Text="我只采集前台窗口标题和键鼠空闲时间，数据全部存在本机，可随时从托盘菜单一键清空。" />
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Left">
            <Button Content="刚才其实在学习" Padding="10,4"
                    Command="{Binding CorrectToFocusedCommand}" />
            <Button Content="刚才其实在休息/玩" Padding="10,4" Margin="8,0,0,0"
                    Command="{Binding CorrectToDistractedCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
