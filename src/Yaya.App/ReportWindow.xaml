<Window x:Class="Yaya.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="芽芽 · 今日复盘" Width="340" Height="230"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <StackPanel Margin="18">
        <TextBlock Text="今日复盘" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{Binding Line1}" FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Line2}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Line3}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                   FontWeight="SemiBold" />
        <Button Content="明天开始" Padding="12,4" Margin="0,16,0,0"
                HorizontalAlignment="Left" Command="{Binding StartTomorrowCommand}" />
    </StackPanel>
</Window>
