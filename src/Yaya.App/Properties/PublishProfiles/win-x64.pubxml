<?xml version="1.0" encoding="utf-8"?>
<!--
  发布演练配置：win-x64 自包含单文件。
  用法：dotnet publish src/Yaya.App -p:PublishProfile=win-x64
  产物：src/Yaya.App/bin/Release/net8.0-windows/win-x64/publish/Yaya.App.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 原生库（SQLite e_sqlite3 等）随包自解压，无需用户机器预装 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 单文件体积压缩（解压到临时目录，首次启动略慢数秒） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Release 不产出调试符号；DEBUG/DEBUG_HOTKEYS 均未定义 -->
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
