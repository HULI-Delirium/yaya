<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Yaya.Core\Yaya.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘占位图标：内嵌资源，运行时不依赖任何外部文件 -->
    <EmbeddedResource Include="Assets\tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 宠物图：Content 复制到输出目录，运行时按相对路径加载；
         美术交付后直接替换发布目录里的 PNG 即可，无需重新编译（换图不改代码） -->
    <Content Include="Assets\pet\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\pet\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- 同一批 PNG 同时内嵌：单文件发布时 Content 不打包，磁盘无文件时从内嵌资源加载（PetAssets 三级回退） -->
    <EmbeddedResource Include="Assets\pet\*.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
