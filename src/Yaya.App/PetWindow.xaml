<Window x:Class="Yaya.App.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="芽芽" Width="200" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <!-- 待机呼吸：常驻循环，Loaded 时由代码启动；锚点 0.5,0.751（真图实测盆底） -->
        <Storyboard x:Key="BreathingStoryboard">
            <DoubleAnimation Storyboard.TargetName="PetScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.03" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PetScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.03" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <!-- 窗口 200x360：底部 200x200 宠物区，上方 160px 透明区留给状态条与气泡 -->
    <Grid x:Name="RootGrid" Width="200" Height="360">
        <!-- 桌宠菜单：右键任意位置可开；左键单击（≤4px、≤300ms）由代码打开同一菜单。
             菜单只抛事件，具体行为（番茄/复盘/历史/设置/显隐/退出）由 App 层接线 -->
        <Grid.ContextMenu>
            <ContextMenu x:Name="PetMenu">
                <MenuItem x:Name="PetPomodoroMenuItem" Header="开始专注 25 分钟"
                          Click="OnMenuTogglePomodoro" />
                <Separator />
                <MenuItem Header="今日复盘…" Click="OnMenuDailyReport" />
                <MenuItem Header="本周报告…" Click="OnMenuWeeklyReport" />
                <MenuItem Header="历史记录…" Click="OnMenuHistory" />
                <MenuItem Header="设置…" Click="OnMenuSettings" />
                <MenuItem x:Name="PetVisibilityMenuItem" Header="隐藏宠物"
                          Click="OnMenuTogglePetVisibility" />
                <Separator />
                <MenuItem Header="退出" Click="OnMenuExit" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- 番茄状态条：200x22，无番茄时隐藏（不占位、不挡宠物）；不参与点击/拖动 -->
        <Border Height="22" Width="150" CornerRadius="11" Background="#E62F6B3F"
                VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPomodoroStatusVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding PomodoroStatusText}" Foreground="White" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <!-- 宠物区：三层变换（倾倒/摇摆/呼吸）同以盆底中点为锚；拖动也只由本区触发 -->
        <Grid x:Name="PetRoot" Width="200" Height="200" VerticalAlignment="Bottom"
              RenderTransformOrigin="0.5,0.751">
            <VisualStateManager.VisualStateGroups>
                <!-- 姿态组：持久互斥；迁移动画全部写在 VisualTransition 里 -->
                <VisualStateGroup x:Name="PostureStates">
                    <VisualStateGroup.Transitions>
                        <!-- Healthy → Wilted：倾倒 12°（2s 缓出）+ wilt_a→wilt_b 交叉淡化（1.5s） -->
                        <VisualTransition From="Healthy" To="Wilted" GeneratedDuration="0:0:2">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PetTilt" Storyboard.TargetProperty="Angle"
                                                 To="12" Duration="0:0:2">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetImageBack" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="PetImageFront" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:1.5"/>
                            </Storyboard>
                        </VisualTransition>
                        <!-- Wilted → Healthy：反放（回正 + 换回 healthy） -->
                        <VisualTransition From="Wilted" To="Healthy" GeneratedDuration="0:0:2">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PetTilt" Storyboard.TargetProperty="Angle"
                                                 To="0" Duration="0:0:2">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetImageBack" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="PetImageFront" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:1.5"/>
                            </Storyboard>
                        </VisualTransition>
                        <!-- 其余迁移（→Weeds / Bloom 等）：直接 0.6s 交叉淡化，不改角度 -->
                        <VisualTransition GeneratedDuration="0:0:0.6">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PetImageBack" Storyboard.TargetProperty="Opacity">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="0"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetName="PetImageFront" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.6"/>
                            </Storyboard>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>

                    <VisualState x:Name="Healthy"/>
                    <VisualState x:Name="Wilted">
                        <!-- 迁移动画结束后由本状态把倾倒角 Hold 在 12° -->
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PetTilt" Storyboard.TargetProperty="Angle"
                                             To="12" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Weeds"/>
                    <VisualState x:Name="Bloom"/>
                </VisualStateGroup>

                <!-- 心情组：与姿态正交；Alert（进入游离）时摇摆停止并回正 -->
                <VisualStateGroup x:Name="MoodStates">
                    <VisualState x:Name="Calm">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PetSway" Storyboard.TargetProperty="Angle"
                                             From="-2" To="2" Duration="0:0:2"
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Alert">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PetSway" Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0.3"/>
                        </Storyboard>
                    </VisualState>
                    <!-- 番茄休息相位：摇摆幅度加大、节奏放慢，不加新图 -->
                    <VisualState x:Name="Relaxed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PetSway" Storyboard.TargetProperty="Angle"
                                             From="-5" To="5" Duration="0:0:1"
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 姿态倾倒层：Healthy 0° / Wilted 12° -->
            <Grid.RenderTransform>
                <RotateTransform x:Name="PetTilt"/>
            </Grid.RenderTransform>

            <!-- 心情摇摆层：Calm ±2° / Alert 0°；独立变换，避免与倾倒角互相覆盖 -->
            <Grid x:Name="PetSwayHost" Width="200" Height="200" RenderTransformOrigin="0.5,0.751">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="PetSway"/>
                </Grid.RenderTransform>

                <!-- 呼吸缩放层：1.0 ↔ 1.03 -->
                <Grid x:Name="PetBreathHost" Width="200" Height="200" RenderTransformOrigin="0.5,0.751">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PetScale"/>
                    </Grid.RenderTransform>

                    <!-- 交叉淡化双层：back=旧图（退场），front=新图（入场） -->
                    <Image x:Name="PetImageBack" Source="{Binding PetBackImage}" Stretch="Uniform" Opacity="0"/>
                    <Image x:Name="PetImageFront" Source="{Binding PetImage}" Stretch="Uniform"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 轻干预气泡：常驻透明区（Opacity 由 DataTrigger 驱动，0.3s 淡入/淡出） -->
        <Border VerticalAlignment="Top" Margin="6,30,6,0"
                Background="#D9FFFFFF" CornerRadius="8" Padding="8"
                IsHitTestVisible="{Binding NudgeVisible}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NudgeVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding NudgeText}" TextWrapping="Wrap" FontSize="12"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Center">
                    <Button Content="有效查资料" FontSize="11" Padding="6,2"
                            Command="{Binding MarkValidCommand}"/>
                    <Button Content="在逃避" FontSize="11" Padding="6,2" Margin="6,0,0,0"
                            Command="{Binding MarkEscapeCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
