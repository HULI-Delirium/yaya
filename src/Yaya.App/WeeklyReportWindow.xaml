<Window x:Class="Yaya.App.WeeklyReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Yaya.App.ViewModels"
        Title="芽芽 · 本周报告" Width="460" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WeekDayNode}">
            <StackPanel HorizontalAlignment="Center" Margin="4,0">
                <Grid Width="44" Height="50">
                    <!-- 花苞：非专注日的已过日 -->
                    <Ellipse Width="18" Height="24" Fill="#FFF3B8D5" Stroke="#FFE8A0C8"
                             StrokeThickness="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Bud">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- 未来日：灰态占位 -->
                    <Ellipse Width="18" Height="24" Fill="#FFE0E0E0" Stroke="#FFBFBFBF"
                             StrokeThickness="1" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Future">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- 开花：专注日（Source 为 null 时不渲染） -->
                    <Image Width="40" Height="46" Source="{Binding BloomImage}" Stretch="Uniform" />
                </Grid>
                <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="本周报告" FontSize="18" FontWeight="Bold" />
        <ItemsControl ItemsSource="{Binding Days}" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="{Binding LineTotal}" FontSize="13" Margin="0,14,0,0" />
        <TextBlock Text="{Binding LineFocusedDays}" FontSize="13" Margin="0,6,0,0" />
        <TextBlock Text="{Binding LinePomodoros}" FontSize="13" Margin="0,6,0,0" />
        <TextBlock Text="{Binding AdviceLine}" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" />
    </StackPanel>
</Window>
