<Application x:Class="Yaya.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <!-- 系统托盘图标：图标内容由代码从内嵌资源加载，不依赖外部文件 -->
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="芽芽 · 学习节律陪伴"
                        MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开主窗口" Click="TrayMenuShowMainWindow" />
                    <MenuItem Header="一键清空本地数据" Click="TrayMenuClearData" />
                    <Separator />
                    <MenuItem Header="退出" Click="TrayMenuExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
