<Application x:Class="Yaya.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <!-- 系统托盘图标：图标内容由代码从内嵌资源加载，不依赖外部文件 -->
    <!-- 缺图回退的矢量占位：简笔花盆，以 200x200 坐标设计，底边中点为锚点。
         放在应用级资源：PetAssets 在宠物窗创建前就要能取到 -->
    <Application.Resources>
        <DrawingImage x:Key="PetPlaceholderImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- 透明满幅底：把 DrawingGroup 边界钉在 200x200 画布，
                         与真图（1024 均匀缩放到 200）共用同一坐标系，缺图回退切换时不跳动；
                         盆底置于 y=150（75%），与真图实测锚点 0.751 对齐 -->
                    <GeometryDrawing Brush="#00FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,200,200"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF7CB342">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="100,108" RadiusX="24" RadiusY="40"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF8D6E63">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="60,112,80,38" RadiusX="6" RadiusY="6"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="芽芽 · 学习节律陪伴"
                        MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="TrayToggleMonitoringItem" Header="暂停采集" Click="TrayMenuToggleMonitoring" />
                    <MenuItem Header="设置…" Click="TrayMenuShowSettings" />
                    <MenuItem Header="今日复盘…" Click="TrayMenuShowReport" />
                    <MenuItem Header="本周报告…" Click="TrayMenuShowWeeklyReport" />
                    <Separator />
                    <MenuItem Header="一键清空本地数据" Click="TrayMenuClearData" />
                    <MenuItem Header="退出" Click="TrayMenuExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
